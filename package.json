{
  "name": "@sanif/pi-chat-suggest",
  "version": "0.1.0",
  "description": "Context-aware next-prompt suggestions inside Pi's editor.",
  "type": "module",
  "main": "index.ts",
  "files": [
    "index.ts",
    "config.ts",
    "logger.ts",
    "messages.ts",
    "state.ts",
    "suggestions.ts",
    "prompt.txt",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/chat-suggest.png"
  ],
  "keywords": ["pi-package", "pi-extension", "prompt-suggestions", "autocomplete", "developer-tools"],
  "author": { "name": "Sanif", "email": "sanifss@gmail.com" },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/sanif/pi-chat-suggest.git" },
  "homepage": "https://github.com/sanif/pi-chat-suggest#readme",
  "bugs": { "url": "https://github.com/sanif/pi-chat-suggest/issues" },
  "engines": { "node": ">=22.19.0" },
  "packageManager": "bun@1.3.14",
  "pi": { "extensions": ["./index.ts"] },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "pack:check": "bun pm pack --dry-run",
    "verify": "bun run typecheck && bun test && bun run pack:check",
    "prepublishOnly": "bun run verify"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.0",
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@earendil-works/pi-tui": "0.84.0",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  },
  "publishConfig": { "access": "public" }
}
